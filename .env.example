# Copy this file to .env and fill it in. Only the first two are required.

# The readers' model (DeepSeek Flash): https://platform.deepseek.com
DEEPSEEK_API_KEY=
# SEC asks automated callers to name themselves: your email, and your name or company
SEC_EDGAR_EMAIL=
SEC_EDGAR_NAME=

# Free, for the risk-free rate: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Optional: the red team on a different model family (Gemini); without it the red team runs on DeepSeek
GEMINI_API_KEY=

# Optional: paper trading with trade_alpaca.py (paper keys start with PK)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
